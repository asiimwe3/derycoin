    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.12",
    "ethers": "^6.16.0",
    "hardhat": "^3.7.0",
    "solc": "^0.8.30"
  }
}
